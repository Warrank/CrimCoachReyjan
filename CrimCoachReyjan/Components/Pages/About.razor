@page "/about"

<PageTitle>About | CrimCoach Reyjan</PageTitle>

<MudText Typo="Typo.h3" Class="mb-3 fw-bold">About Reyjan Paches</MudText>
<MudText Class="mb-4">Reyjan helps criminology students turn complex theory into understandable, test-ready knowledge. His coaching style combines academic clarity with practical exam strategy.</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="p-4 h-100" Elevation="1">
            <MudText Typo="Typo.h5" Class="mb-2">Mission</MudText>
            <MudText>To make criminology education accessible, structured, and confidence-building for every student regardless of starting level.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="p-4 h-100" Elevation="1">
            <MudText Typo="Typo.h5" Class="mb-2">Vision</MudText>
            <MudText>Build a strong learning community where students are prepared not only for exams, but also for real-world criminal justice contexts.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="p-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">Why students choose Reyjan</MudText>
    <MudList Dense="true">
        <MudListItem>Clear explanation of difficult topics.</MudListItem>
        <MudListItem>Focused preparation for exams and assignments.</MudListItem>
        <MudListItem>Personal feedback and progress tracking.</MudListItem>
        <MudListItem>Modern teaching style with practical examples.</MudListItem>
    </MudList>
</MudPaper>
