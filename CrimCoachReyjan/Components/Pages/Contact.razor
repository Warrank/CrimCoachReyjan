@page "/contact"

<PageTitle>Contact | CrimCoach Reyjan</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4 fw-bold">Contact</MudText>
<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Email</MudText>
                <MudText Class="mb-3">For enrollment and coaching questions.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="mailto:info@crimcoachreyjan.com">Send Email</MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Message / WhatsApp</MudText>
                <MudText Class="mb-3">Reach out directly via one of the numbers below.</MudText>
                <MudStack Spacing="1">
                    <MudLink Href="https://wa.me/310600000001" Target="_blank">+31 06 0000 0001</MudLink>
                    <MudLink Href="https://wa.me/310600000002" Target="_blank">+31 06 0000 0002</MudLink>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
