@page "/enroll"

<PageTitle>Enroll | CrimCoach Reyjan</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4 fw-bold">Enrollment options</MudText>
<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Starter Plan</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Primary">€49/mo</MudText>
                <MudList Dense="true">
                    <MudListItem>Weekly study guide</MudListItem>
                    <MudListItem>1 group Q&A session</MudListItem>
                    <MudListItem>Access to study resources</MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions><MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/contact">Choose plan</MudButton></MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Pro Coaching</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Primary">€99/mo</MudText>
                <MudList Dense="true">
                    <MudListItem>Everything in Starter</MudListItem>
                    <MudListItem>2 personal sessions / month</MudListItem>
                    <MudListItem>Assignment review support</MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions><MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/contact">Choose plan</MudButton></MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Exam Intensive</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h4" Color="Color.Primary">€179/mo</MudText>
                <MudList Dense="true">
                    <MudListItem>Weekly 1:1 coaching</MudListItem>
                    <MudListItem>Mock exam simulations</MudListItem>
                    <MudListItem>Priority mentor feedback</MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions><MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/contact">Choose plan</MudButton></MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
