@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">
        <MudText Typo="Typo.h6" Class="fw-bold">CrimCoach Reyjan</MudText>
        <MudSpacer />
        <MudTabs Rounded="true" Centered="true" Elevation="0" Color="Color.Inherit" SliderColor="Color.Secondary" Class="top-nav-tabs">
            <MudTabPanel Text="Home" OnClick="() => GoTo(\"/\")" />
            <MudTabPanel Text="About" OnClick="() => GoTo(\"/about\")" />
            <MudTabPanel Text="Enroll" OnClick="() => GoTo(\"/enroll\")" />
            <MudTabPanel Text="Free Lessons" OnClick="() => GoTo(\"/free-lessons\")" />
            <MudTabPanel Text="Contact" OnClick="() => GoTo(\"/contact\")" />
        </MudTabs>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 content-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void GoTo(string url) => Navigation.NavigateTo(url);
}
